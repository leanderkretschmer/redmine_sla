<%# Globale Plugin-Einstellungen: Vorbelegung neuer Projekt-SLAs und Zeitzone %>
<p class="sla-help">
  <%= l(:text_sla_plugin_settings_help) %>
  <%= link_to l(:label_sla_admin), sla_admin_path %>
</p>

<p>
  <label for="settings_default_initial_response_time_minutes"><%= l(:field_sla_initial_response_time) %></label>
  <%= number_field_tag 'settings[default_initial_response_time_minutes]', settings['default_initial_response_time_minutes'] || '60', min: 1, size: 6 %>
  <%= l(:label_minutes) %>
  <em class="info"><%= l(:text_sla_initial_response_time_info) %></em>
</p>
<p>
  <label for="settings_default_response_time_minutes"><%= l(:field_sla_response_time) %></label>
  <%= number_field_tag 'settings[default_response_time_minutes]', settings['default_response_time_minutes'] || '600', min: 1, size: 6 %>
  <%= l(:label_minutes) %>
  <em class="info"><%= l(:text_sla_response_time_info) %></em>
</p>
<p>
  <label for="settings_default_puffer_minutes"><%= l(:field_sla_puffer) %></label>
  <%= number_field_tag 'settings[default_puffer_minutes]', settings['default_puffer_minutes'] || '120', min: 0, size: 6 %>
  <%= l(:label_minutes) %>
</p>
<p>
  <label for="settings_default_sod_hour"><%= l(:field_sla_sod_hour) %></label>
  <%= number_field_tag 'settings[default_sod_hour]', settings['default_sod_hour'] || '7', min: 0, max: 23, size: 3 %>
  <%= l(:label_sla_oclock) %>
</p>
<p>
  <label for="settings_default_eod_hour"><%= l(:field_sla_eod_hour) %></label>
  <%= number_field_tag 'settings[default_eod_hour]', settings['default_eod_hour'] || '18', min: 1, max: 24, size: 3 %>
  <%= l(:label_sla_oclock) %>
</p>
<p>
  <label for="settings_time_zone"><%= l(:field_sla_time_zone) %></label>
  <%= select_tag 'settings[time_zone]',
                 options_for_select(ActiveSupport::TimeZone.all.map { |z| [z.to_s, z.tzinfo.name] }.uniq { |_, v| v }.sort_by(&:first), (ActiveSupport::TimeZone[settings['time_zone'].to_s]&.tzinfo&.name || 'Europe/Berlin')) %>
  <em class="info"><%= l(:text_sla_time_zone_setting_info) %></em>
</p>

<fieldset class="box">
  <legend><%= l(:label_sla_excluded_statuses) %></legend>
  <p class="sla-help"><%= l(:text_sla_excluded_statuses_help) %></p>
  <% selected = Array(settings['excluded_status_ids']).map(&:to_s).reject(&:blank?) %>
  <% selected = IssueStatus.where(is_closed: true).pluck(:id).map(&:to_s) if selected.empty? %>
  <%= hidden_field_tag 'settings[excluded_status_ids][]', '', id: nil %>
  <p class="sla-status-list">
    <% IssueStatus.sorted.each do |st| %>
      <label class="sla-status-option">
        <%= check_box_tag 'settings[excluded_status_ids][]', st.id, selected.include?(st.id.to_s), id: "sla_status_#{st.id}" %>
        <%= h(st.name) %><%= ' (' + l(:field_is_closed) + ')' if st.is_closed? %>
      </label>
    <% end %>
  </p>
  <p class="sla-help"><%= l(:text_sla_excluded_statuses_rebuild) %> <%= link_to l(:button_sla_rebuild), rebuild_sla_admin_path, method: :post, data: { confirm: l(:text_sla_rebuild_confirm) } %></p>
</fieldset>

<fieldset class="box">
  <legend><%= l(:label_sla_internal_users) %></legend>
  <p class="sla-help"><%= l(:text_sla_internal_users_help) %></p>
  <p>
    <label for="settings_admins_internal"><%= l(:field_sla_admins_internal) %></label>
    <%= hidden_field_tag 'settings[admins_internal]', '0', id: nil %>
    <%= check_box_tag 'settings[admins_internal]', '1', settings['admins_internal'].to_s != '0' %>
  </p>
  <p>
    <label for="settings_internal_group_id"><%= l(:field_sla_internal_group) %></label>
    <%= select_tag 'settings[internal_group_id]',
                   options_for_select([[l(:label_none), '']] + Group.givable.sorted.map { |g| [g.name, g.id] }, settings['internal_group_id']) %>
  </p>
</fieldset>
