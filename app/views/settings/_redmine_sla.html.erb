<%# Globale Plugin-Einstellungen: Vorbelegung neuer Projekt-SLAs und Zeitzone %>
<p class="sla-help">
  <%= l(:text_sla_plugin_settings_help) %>
  <%= link_to l(:label_sla_admin), sla_admin_path %>
</p>

<p>
  <label for="settings_default_response_time_minutes"><%= l(:field_sla_response_time) %></label>
  <%= number_field_tag 'settings[default_response_time_minutes]', settings['default_response_time_minutes'] || '240', min: 1, size: 6 %>
  <%= l(:label_minutes) %>
</p>
<p>
  <label for="settings_default_puffer_minutes"><%= l(:field_sla_puffer) %></label>
  <%= number_field_tag 'settings[default_puffer_minutes]', settings['default_puffer_minutes'] || '120', min: 0, size: 6 %>
  <%= l(:label_minutes) %>
</p>
<p>
  <label for="settings_default_sod_hour"><%= l(:field_sla_sod_hour) %></label>
  <%= number_field_tag 'settings[default_sod_hour]', settings['default_sod_hour'] || '7', min: 0, max: 23, size: 3 %>
  <%= l(:label_sla_oclock) %>
</p>
<p>
  <label for="settings_default_eod_hour"><%= l(:field_sla_eod_hour) %></label>
  <%= number_field_tag 'settings[default_eod_hour]', settings['default_eod_hour'] || '18', min: 1, max: 24, size: 3 %>
  <%= l(:label_sla_oclock) %>
</p>
<p>
  <label for="settings_time_zone"><%= l(:field_sla_time_zone) %></label>
  <%= select_tag 'settings[time_zone]',
                 options_for_select(ActiveSupport::TimeZone.all.map { |z| [z.to_s, z.name] }, settings['time_zone'] || 'Europe/Berlin') %>
  <em class="info"><%= l(:text_sla_time_zone_setting_info) %></em>
</p>
