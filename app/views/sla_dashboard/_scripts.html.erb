<%# Fokus-Modus (Projekt im Vollbild-Grid) und Popup für Einträge; wird einmal pro Seite eingebunden %>
<% unless @sla_scripts_rendered %>
<% @sla_scripts_rendered = true %>
<div class="sla-overlay" id="sla-overlay" hidden>
  <div class="sla-overlay-box" role="dialog" aria-modal="true">
    <div class="sla-overlay-bar">
      <span class="sla-overlay-title"></span>
      <span class="sla-overlay-actions">
        <a href="#" class="sla-overlay-exclude" hidden><%= l(:button_sla_exclude) %></a>
        <a href="#" class="sla-overlay-open" target="_blank"><%= l(:label_sla_open_issue) %></a>
        <button type="button" class="sla-overlay-close" title="<%= l(:button_close) %> (Esc)">&times;</button>
      </span>
    </div>
    <div class="sla-overlay-content"></div>
  </div>
</div>
<%= javascript_tag nonce: true do %>
(function () {
  var overlay = document.getElementById('sla-overlay');
  if (!overlay) return;
  var csrf = (document.querySelector('meta[name="csrf-token"]') || {}).content || '';
  var strings = { excluded: <%= l(:notice_sla_excluded).to_json.html_safe %>, error: <%= l(:error_sla_request_failed).to_json.html_safe %> };

  // ── Popup ───────────────────────────────────────────────
  var excludeLink = overlay.querySelector('.sla-overlay-exclude');
  var currentCard = null;
  function closeOverlay() { overlay.hidden = true; overlay.querySelector('.sla-overlay-content').innerHTML = ''; excludeLink.hidden = true; currentCard = null; }
  function openOverlay(card) {
    var url = card.getAttribute('data-detail-url');
    var issueUrl = card.getAttribute('data-issue-url');
    var content = overlay.querySelector('.sla-overlay-content');
    currentCard = card;
    overlay.querySelector('.sla-overlay-title').textContent = card.getAttribute('data-title') || '';
    overlay.querySelector('.sla-overlay-open').href = issueUrl || '#';
    excludeLink.hidden = true;
    content.innerHTML = '<p class="sla-muted">…</p>';
    overlay.hidden = false;
    fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' }, credentials: 'same-origin' })
      .then(function (r) { if (!r.ok) throw new Error(r.status); return r.text(); })
      .then(function (html) {
        content.innerHTML = html;
        var popup = content.querySelector('.sla-popup');
        if (popup && popup.getAttribute('data-exclude-url')) {
          excludeLink.setAttribute('data-url', popup.getAttribute('data-exclude-url'));
          excludeLink.setAttribute('data-confirm', popup.getAttribute('data-exclude-confirm') || '');
          excludeLink.hidden = false;
        }
        var target = popup && document.getElementById(popup.getAttribute('data-highlight'));
        if (target) target.scrollIntoView({ block: 'center' });
      })
      .catch(function () { content.innerHTML = '<p class="sla-muted">' + strings.error + '</p>'; });
  }
  excludeLink.addEventListener('click', function (e) {
    e.preventDefault();
    if (excludeLink.hidden || excludeLink.classList.contains('sla-busy')) return;
    if (!confirm(excludeLink.getAttribute('data-confirm'))) return;
    excludeLink.classList.add('sla-busy');
    var card = currentCard;
    fetch(excludeLink.getAttribute('data-url'), { method: 'POST', credentials: 'same-origin',
      headers: { 'X-CSRF-Token': csrf, 'X-Requested-With': 'XMLHttpRequest', 'Accept': 'application/json' } })
      .then(function (r) { if (!r.ok) throw new Error(r.status); return r.json(); })
      .then(function () { closeOverlay(); if (card) card.remove(); window.location.reload(); })
      .catch(function () { excludeLink.classList.remove('sla-busy'); alert(strings.error); });
  });
  overlay.addEventListener('click', function (e) {
    if (e.target === overlay || e.target.closest('.sla-overlay-close')) closeOverlay();
  });

  // ── Fokus-Modus: nur ein Projekt, Einträge als Raster in voller Breite ──
  var labels = { all: <%= l(:button_sla_all_projects).to_json.html_safe %>, project: <%= l(:label_sla_project_page).to_json.html_safe %> };
  function closeFocus(board) {
    board.classList.remove('sla-focused');
    board.querySelectorAll('.sla-column').forEach(function (c) { c.classList.remove('sla-focused-column'); c.hidden = false; });
    var bar = board.querySelector('.sla-focus-bar'); if (bar) bar.remove();
  }
  function openFocus(board, column) {
    closeFocus(board);
    board.classList.add('sla-focused');
    board.querySelectorAll('.sla-column').forEach(function (c) { c.hidden = (c !== column); });
    column.classList.add('sla-focused-column');
    var bar = document.createElement('div'); bar.className = 'sla-focus-bar';
    bar.innerHTML = '<span class="sla-focus-title"></span><span class="sla-focus-actions"><a class="sla-focus-project"></a> <button type="button" class="sla-focus-close"></button></span>';
    bar.querySelector('.sla-focus-title').textContent = column.getAttribute('data-project-name') || '';
    var pl = bar.querySelector('.sla-focus-project'); pl.textContent = labels.project; pl.href = column.getAttribute('data-project-url') || '#';
    var cb = bar.querySelector('.sla-focus-close'); cb.textContent = labels.all;
    cb.addEventListener('click', function () { closeFocus(board); });
    board.insertBefore(bar, board.firstChild);
  }

  // ── "Mir zugewiesen"-Filter ─────────────────────────────
  var mineKey = 'redmine_sla_mine';
  function applyMine(on) {
    document.querySelectorAll('[data-sla-board]').forEach(function (board) {
      board.classList.toggle('sla-mine', on);
      board.querySelectorAll('.sla-column').forEach(function (col) {
        var cards = col.querySelectorAll('.sla-card');
        var visible = on ? col.querySelectorAll('.sla-card.sla-mine-card').length : cards.length;
        var count = col.querySelector('.sla-count'); if (count) count.textContent = visible;
        if (!col.classList.contains('sla-focused-column') && !board.classList.contains('sla-focused')) col.hidden = (on && visible === 0);
      });
    });
    document.querySelectorAll('.sla-mine-toggle').forEach(function (b) { b.classList.toggle('sla-active', on); b.setAttribute('aria-pressed', on ? 'true' : 'false'); });
  }
  var mineOn = false;
  try { mineOn = localStorage.getItem(mineKey) === '1'; } catch (e) {}
  if (document.querySelector('.sla-mine-toggle')) applyMine(mineOn);
  document.addEventListener('click', function (e) {
    var t = e.target.closest('.sla-mine-toggle');
    if (!t) return;
    mineOn = !mineOn;
    try { localStorage.setItem(mineKey, mineOn ? '1' : '0'); } catch (err) {}
    applyMine(mineOn);
  });

  document.addEventListener('keydown', function (e) {
    if (e.key !== 'Escape') return;
    if (!overlay.hidden) { closeOverlay(); return; }
    document.querySelectorAll('[data-sla-board].sla-focused').forEach(closeFocus);
  });
  document.addEventListener('click', function (e) {
    var toggle = e.target.closest('.sla-focus-toggle');
    if (toggle && toggle.closest('[data-sla-board]')) {
      e.preventDefault();
      var board = toggle.closest('[data-sla-board]');
      var column = toggle.closest('.sla-column');
      if (column.classList.contains('sla-focused-column')) closeFocus(board); else openFocus(board, column);
      return;
    }
    var card = e.target.closest('.sla-card[data-detail-url]');
    if (card && !e.target.closest('a.user') && !(e.ctrlKey || e.metaKey || e.button === 1)) {
      e.preventDefault();
      openOverlay(card);
    }
  });
})();
<% end %>
<% end %>
