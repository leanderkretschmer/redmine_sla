<%# My Page SLA Widget Preview %>
<div class="widget-sla-preview">
  <h3><%= l(:label_sla_dashboard) %></h3>
  <% if @sla_overview_data&.any? %>
    <div class="sla-compact-list">
      <% @sla_overview_data.first(10).each do |deadline| %>
        <div class="sla-compact-item sla-<%= deadline.status_label %>">
          <%= link_to "##{deadline.issue.id}", issue_path(deadline.issue) %>
          <%= deadline.status_label.upcase %>
          <span class="deadline-due"><%= deadline.internal_deadline.strftime('%d.%m. %H:%M') %></span>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="nodata"><%= l(:label_sla_no_tickets) %></p>
  <% end %>
  <%= link_to l(:sla_menu), { controller: 'sla_dashboard', action: 'index' }, class: 'button' %>
</div>
