<p class="sla-help"><%= l(:text_sla_holidays_help) %></p>

<%= form_for @holiday, as: :sla_holiday, url: sla_holidays_path, html: { class: 'tabular sla-inline-form' } do |f| %>
  <fieldset class="box">
    <legend><%= l(:label_sla_add_holiday) %></legend>
    <p><%= f.text_field :name, size: 40, required: true, label: :field_name %></p>
    <p><%= f.date_field :date, required: true, label: :field_date %></p>
    <p><%= f.select :project_id,
                     options_for_select([[l(:label_all_projects), '']] + Project.active.sorted.map { |p| [p.name, p.id] }),
                     label: :field_project %></p>
    <p><%= f.submit l(:button_add), name: nil %></p>
  </fieldset>
<% end %>

<% if @holidays.empty? %>
  <p class="nodata"><%= l(:label_no_data) %></p>
<% else %>
  <table class="list">
    <thead>
      <tr>
        <th><%= l(:field_date) %></th>
        <th><%= l(:field_name) %></th>
        <th><%= l(:field_project) %></th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @holidays.each do |hd| %>
        <tr class="<%= cycle('odd', 'even') %>">
          <td><%= format_date(hd.date) %></td>
          <td><%= h(hd.name) %></td>
          <td><%= hd.project ? h(hd.project.name) : l(:label_all_projects) %></td>
          <td class="buttons">
            <%= link_to l(:button_delete), sla_holiday_path(hd), method: :delete,
                        data: { confirm: l(:text_are_you_sure) }, class: 'icon icon-del' %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>
