<%# Partial: SLA Ticket Card %>
<% deadline = local_assigns[:deadline] %>
<% issue = deadline.issue %>
<% status = deadline.status %>

<div class="sla-ticket-card sla-<%= status %>">
  <div class="card-indicator"></div>
  <div class="card-content">
    <div class="card-header">
      <span class="ticket-id">
        <%= link_to "##{issue.id} #{h(issue.subject)}", issue_path(issue) %>
      </span>
      <span class="status-badge sla-<%= deadline.status_label %>">
        <%= l("label_sla_#{deadline.status_label}") %>
      </span>
    </div>

    <div class="card-details">
      <% if issue.assigned_to %>
        <div class="detail-row">
          <span class="label"><%= l(:field_assigned_to) %>:</span>
          <span class="value">
            <%= avatar(issue.assigned_to, size: "18") %>
            <%= link_to h(issue.assigned_to.name), member_path(issue.project, issue.assigned_to) %>
          </span>
        </div>
      <% end %>

      <% if deadline.external_comment %>
        <div class="detail-row">
          <span class="label"><%= l(:label_last_external_comment) %>:</span>
          <span class="value">
            <span class="comment-author"><%= h(deadline.external_comment.<EMAIL>) %></span>
            <span class="comment-time"><%= format_time(deadline.external_comment.created_at) %></span>
          </span>
        </div>
      <% end %>

      <div class="detail-row deadline-row">
        <span class="label"><%= l(:label_deadline) %>:</span>
        <span class="value deadline-value">
          <%= deadline.internal_deadline.strftime('%d.%m.%Y') %>
          <%= deadline.internal_deadline.strftime('%H:%M') %>
        </span>
      </div>
    </div>
  </div>
</div>
