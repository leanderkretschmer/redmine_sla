<h2><%= link_to l(:label_sla_admin), sla_admin_path %> &#187; <%= l(:new_sla_rule) %></h2>

<%= form_for @sla_rule, as: :sla_rule, url: sla_rules_path, method: :post do |f| %>
  <%= render partial: 'form', locals: { f: f } %>
  <%= f.submit l(:button_create) %>
  <%= link_to l(:button_cancel), sla_admin_path(tab: 'rules') %>
<% end %>
