<div class="sla-tab-intro">
  <p><%= l(:text_sla_rules_help) %></p>
  <p><%= link_to l(:new_sla_rule), new_sla_rule_path, class: 'icon icon-add' %></p>
</div>

<% if @rules.empty? %>
  <p class="nodata"><%= l(:label_no_sla_rules) %></p>
<% else %>
  <table class="list">
    <thead>
      <tr>
        <th><%= l(:label_sla_rule) %></th>
        <th><%= l(:field_project) %></th>
        <th><%= l(:field_tracker) %></th>
        <th><%= l(:field_sla_response_time) %></th>
        <th><%= l(:label_resolution_time) %></th>
        <th><%= l(:field_priority) %></th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @rules.each do |rule| %>
        <tr class="<%= cycle('odd', 'even') %>">
          <td class="name"><%= link_to h(rule.name), edit_sla_rule_path(rule) %>
            <% if rule.description.present? %><br><span class="sla-muted"><%= h(rule.description) %></span><% end %></td>
          <td><%= rule.project ? h(rule.project.name) : l(:label_all_projects) %></td>
          <td><%= rule.tracker ? h(rule.tracker.name) : l(:label_all_trackers) %></td>
          <td><%= rule.response_time_minutes %> <%= l(:label_minutes) %> <span class="sla-muted">(<%= (rule.response_time_minutes / 60.0).round(1) %> h)</span></td>
          <td><%= rule.resolution_time_minutes ? "#{rule.resolution_time_minutes} #{l(:label_minutes)}" : '–' %></td>
          <td><%= rule.priority %></td>
          <td class="buttons">
            <%= link_to l(:button_edit), edit_sla_rule_path(rule), class: 'icon icon-edit' %>
            <%= link_to l(:button_delete), sla_rule_path(rule), method: :delete,
                        data: { confirm: l(:text_are_you_sure) }, class: 'icon icon-del' %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>
