<h2><%= l(:label_sla_rules) %></h2>

<div class="contextual">
  <%= link_to l(:new_sla_rule), new_sla_rule_path, class: 'icon icon-add' %>
</div>

<table class="list">
  <thead>
    <tr>
      <th><%= l(:label_sla_rule) %></th>
      <th><%= l(:field_project) %></th>
      <th><%= l(:field_tracker) %></th>
      <th><%= l(:label_resolution_time) %></th>
      <th><%= l(:label_response_time) %></th>
      <th><%= l(:field_priority) %></th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% @sla_rules.each do |rule| %>
      <tr>
        <td><%= link_to h(rule.name), edit_sla_rule_path(rule) %></td>
        <td><%= rule.project ? h(rule.project.name) : l(:label_all_projects) %></td>
        <td><%= rule.tracker ? h(rule.tracker.name) : l(:label_all_trackers) %></td>
        <td><%= rule.resolution_time_minutes ? "#{rule.resolution_time_minutes} min" : '-' %></td>
        <td><%= rule.response_time_minutes ? "#{rule.response_time_minutes} min" : '-' %></td>
        <td><%= rule.priority %></td>
        <td>
          <%= link_to l(:button_edit), edit_sla_rule_path(rule), class: 'icon icon-edit' %>
          <%= link_to l(:button_delete), sla_rule_path(rule), method: :delete, data: { confirm: l(:warning_confirm_deletion) }, class: 'icon icon-delete' %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<% if @sla_rules.empty? %>
  <p class="nodata"><%= l(:label_no_sla_rules) %></p>
<% end %>
