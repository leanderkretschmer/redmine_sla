<% content_for :header_url, sla_dashboard_path %>

<h2>
  <span class="icon icon-sla"></span>
  <%= l(:label_sla_dashboard) %>
</h2>

<!-- Stats Overview -->
<div class="sla-stats-overview">
  <div class="stat-item stat-breached">
    <span class="stat-number"><%= @stats[:breached] %></span>
    <span class="stat-label"><%= l(:label_sla_breached) %></span>
  </div>
  <div class="stat-item stat-at_risk">
    <span class="stat-number"><%= @stats[:at_risk] %></span>
    <span class="stat-label"><%= l(:label_sla_at_risk) %></span>
  </div>
  <div class="stat-item stat-ok">
    <span class="stat-number"><%= @stats[:ok] %></span>
    <span class="stat-label"><%= l(:label_sla_ok) %></span>
  </div>
</div>

<!-- Legend -->
<div class="sla-legend">
  <span class="legend-item legend-green"><span class="legend-dot green"></span> <%= l(:label_sla_ok) %></span>
  <span class="legend-item legend-yellow"><span class="legend-dot yellow"></span> <%= l(:label_sla_at_risk) %></span>
  <span class="legend-item legend-red"><span class="legend-dot red"></span> <%= l(:label_sla_breached) %></span>
</div>

<!-- Project Columns -->
<div class="sla-project-columns">
  <% @project_deadlines.each do |project, deadlines| %>
    <div class="sla-project-column">
      <div class="column-header">
        <h3><%= link_to h(project.name), project_path(project) %></h3>
        <span class="count-badge"><%= deadlines.count %></span>
      </div>

      <div class="column-body">
        <% deadlines.each do |deadline| %>
          <%= render partial: 'sla_ticket_card', locals: { deadline: deadline } %>
        <% end %>
      </div>
    </div>
  <% end %>

  <% if @project_deadlines.empty? %>
    <div class="sla-no-tickets">
      <p class="nodata"><%= l(:label_sla_no_tickets) %></p>
    </div>
  <% end %>
</div>
