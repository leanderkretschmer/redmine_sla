<%# Ampelkarte für eine offene Antwortpflicht %>
<% issue = deadline.issue %>
<% author = deadline.external_author %>
<div class="sla-card sla-<%= deadline.traffic_light %>" title="<%= l("label_sla_#{deadline.status_label}") %>"<% unless local_assigns[:embed] %> data-detail-url="<%= sla_deadline_path(deadline) %>" data-issue-url="<%= issue_url(issue, anchor: (deadline.journal ? "change-#{deadline.journal.id}" : nil)) %>" data-title="#<%= issue.id %> <%= h(issue.subject) %>"<% end %>>
  <div class="sla-card-title">
    <%= link_to "##{issue.id} #{issue.subject}", issue_url(issue, anchor: (deadline.journal ? "change-#{deadline.journal.id}" : nil)), class: "issue #{issue.css_classes}".strip, target: (local_assigns[:embed] ? '_top' : nil) %>
  </div>
  <div class="sla-card-row">
    <span class="sla-label"><%= deadline.from_comment? ? l(:label_sla_comment_by) : l(:label_sla_ticket_by) %>:</span>
    <span class="sla-value"><%= author ? (local_assigns[:embed] ? h(author.name) : link_to_user(author)) : l(:label_sla_unknown_author) %></span>
  </div>
  <div class="sla-card-row sla-muted">
    <%= format_time(deadline.external_comment_time) %>
  </div>
  <div class="sla-card-row sla-due">
    <span class="sla-label"><%= l(:label_sla_due) %>:</span>
    <span class="sla-value"><%= format_time(deadline.internal_deadline) %></span>
  </div>
  <% if issue.assigned_to %>
    <div class="sla-card-row sla-muted sla-assignee">
      <%= l(:field_assigned_to) %>: <%= local_assigns[:embed] ? h(issue.assigned_to.name) : link_to_user(issue.assigned_to) %>
    </div>
  <% end %>
</div>
